# Локально скопируйте в .env.local (не коммитить).
# На Vercel: Project → Settings → Environment Variables (Production и при желании Preview).

# EmailJS — форма на главной
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Telegram — уведомления о заявках (опционально)
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_CHAT_ID=

# ИИ-чат на /ironpulse (только сервер, без префикса NEXT_PUBLIC_)
OPENAI_API_KEY=
